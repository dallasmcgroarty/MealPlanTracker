---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Calorie History & Nutrition Trends | Nawtch"
  description="See your complete calorie, macro, and spending history with Nawtch. Explore daily and weekly trends with interactive graphs, and export your data anytime."
  canonicalPath="/history/"
>
  <!-- ECharts CDN -->
  <script src="https://cdn.jsdelivr.net/npm/echarts@5.5.0/dist/echarts.min.js" defer></script>

  <header class="history-header header-left">
    <div>
      <h1>Calorie History & Progress Tracking</h1>
      <p class="subtitle">Review your calorie history, macro trends, and weight progress over time with easy-to-read nutrition charts.</p>
    </div>
    <div style="display:flex;flex-direction:column;align-items:flex-end;gap:10px;">
      <span style="font-family:'DM Mono',monospace;font-size:10px;color:var(--muted);">stored locally</span>
      <div class="export-dropdown">
        <button class="ghost-btn export-dropdown-trigger" onclick="window.toggleExportDropdown(event)">Export ▾</button>
        <div class="export-dropdown-menu">
          <button onclick="window.exportHistory('csv')">↓ CSV</button>
          <button onclick="window.exportHistory('json')">↓ JSON</button>
        </div>
      </div>
    </div>
  </header>
  <!-- Overall charts accordion -->
  <div id="history-charts-overall" class="stats-accordion-wrap" style="display:none;">
    <button class="stats-accordion-toggle" onclick="window.toggleStatsAccordion()">
      <span>Your Stats</span>
      <span class="stats-accordion-chevron">&#9660;</span>
    </button>
    <div class="stats-accordion-body" id="stats-accordion-body">
    <div style="display:flex;flex-wrap:wrap;gap:32px;justify-content:center;">
      <div style="min-width:320px;max-width:420px;width:100%;">
        <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:6px;margin-bottom:4px;">
          <div style="font-family:'Syne',sans-serif;font-size:14px;color:var(--muted);" id="hist-cal-title">Calories per Day</div>
          <div class="wt-toggle" id="hist-cal-toggle">
            <button class="wt-toggle-btn active" id="hist-cal-toggle-daily" onclick="window.histSetCalChartMode('daily')">Daily</button>
            <button class="wt-toggle-btn" id="hist-cal-toggle-weekly" onclick="window.histSetCalChartMode('weekly')">Weekly</button>
          </div>
        </div>
        <div id="chart-calories" class="echart-container"></div>
      </div>
      <div style="min-width:320px;max-width:420px;width:100%;">
        <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:6px;margin-bottom:4px;">
          <div style="font-family:'Syne',sans-serif;font-size:14px;color:var(--muted);" id="hist-cost-title">Weekly Cost</div>
          <div class="wt-toggle" id="hist-cost-toggle">
            <button class="wt-toggle-btn active" id="hist-cost-toggle-weekly" onclick="window.histSetCostChartMode('weekly')">Weekly</button>
            <button class="wt-toggle-btn" id="hist-cost-toggle-monthly" onclick="window.histSetCostChartMode('monthly')">Monthly</button>
          </div>
        </div>
        <div id="chart-weekly-cost" class="echart-container"></div>
      </div>
      <div style="min-width:220px;max-width:320px;width:100%;">
        <div style="font-family:'Syne',sans-serif;font-size:14px;color:var(--muted);margin-bottom:4px;">Macro Split</div>
        <div id="chart-macros" class="echart-container echart-macros"></div>
      </div>
    </div>
    </div><!-- end stats-accordion-body -->
  </div>
  <div id="history-content"></div>
  <div class="info-banners">
    <div class="info-banner">
      <div class="info-banner-header" onclick="this.parentElement.classList.toggle('open')">
        <div class="info-dot" style="background:var(--accent2);box-shadow:0 0 6px var(--accent2);"></div>
        <span class="info-banner-label info-label-warn">Your history is organized months → weeks → days</span>
        <span class="info-banner-chevron">▼</span>
      </div>
      <div class="info-banner-body">
        Click a month to expand or collapse its weeks, then click a week to expand its day-by-day table —
        calories, protein, carbs, fat, cost, and whether that day landed inside your calorie range. The current
        week opens pre-expanded, so once you open its month you don't need an extra click to see it.
      </div>
    </div>
    <div class="info-banner">
      <div class="info-banner-header" onclick="this.parentElement.classList.toggle('open')">
        <div class="info-dot" style="background:var(--muted);box-shadow: 0 0 6px var(--muted);"></div>
        <span class="info-banner-label info-label-info">Weeks that cross a month boundary are split, not lost</span>
        <span class="info-banner-chevron">▼</span>
      </div>
      <div class="info-banner-body">
        A week spanning two calendar months appears under both months, marked with a badge like <strong>↑ from Jan</strong> or <strong>↓ into Feb</strong>. Each day is only counted once — in the month
        it actually falls in — so nothing gets double-counted or dropped.
      </div>
    </div>
    <div class="info-banner">
      <div class="info-banner-header" onclick="this.parentElement.classList.toggle('open')">
        <div class="info-dot" style="background:var(--carbs);box-shadow: 0 0 6px var(--carbs);"></div>
        <span class="info-banner-label info-label-warn-2">Export your full history as CSV or JSON anytime</span>
        <span class="info-banner-chevron">▼</span>
      </div>
      <div class="info-banner-body">
        The <strong>Export</strong> button in the header downloads your complete logged history — not just
        what's currently visible on screen — as either a <strong>CSV</strong> or <strong>JSON</strong> file.
      </div>
    </div>
  </div>
  <p class="field-hint" style="display:block;margin-top:14px;">
    Trend look off from your target? Revisit your range with the <a href="/calculators/tdee/">TDEE calculator</a>.
  </p>

  <script src="../../islands/vanilla/history/history.js"></script>
</BaseLayout>
