---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Nawtch — Free Calorie & Macro Tracker, No Account Needed"
  description="Free calorie and macro tracker, no account needed. Log food, cost, and weight — plus a free calorie and TDEE calculator. All data stays on your device"
  canonicalPath="/"
>
  <header>
    <div class="header-left">
      <h1>Calorie & Macro Tracker</h1>
      <p class="subtitle">
        Log meals · Track calories & macros · Monitor your nutrition
        progress
      </p>
    </div>
    <div class="date-badge">
      <div class="date-day" id="hdr-date">—</div>
      <div class="date-reset">Resets at midnight</div>
    </div>
  </header>

  <!-- STATUS -->
  <div class="status-banner" id="status-banner">
    <div class="status-dot" id="status-dot"></div>
    <div class="status-text" id="status-text">Loading...</div>
  </div>

  <!-- TOTALS: cal / protein / carbs / fat / spent today / target today -->
  <div class="totals-grid">
    <div class="total-card tc-cal">
      <div class="val" id="tot-cal">0</div>
      <div class="lbl" id="tot-cal-lbl">Logged kcal</div>
      <div class="sub" id="tot-cal-sub">/ 1,250 target</div>
    </div>
    <div class="total-card tc-p">
      <div class="val" id="tot-p">0g</div>
      <div class="lbl">Protein</div>
    </div>
    <div class="total-card tc-c">
      <div class="val" id="tot-c">0g</div>
      <div class="lbl">Carbs</div>
    </div>
    <div class="total-card tc-f">
      <div class="val" id="tot-f">0g</div>
      <div class="lbl">Fat</div>
    </div>
    <div class="total-card tc-spent">
      <div class="val" id="tot-spent">$0.00</div>
      <div class="lbl">Spent Today</div>
      <div class="sub" id="tot-spent-sub">actual</div>
    </div>
    <div class="total-card tc-target">
      <div class="val" id="tot-target-cost">$0.00</div>
      <div class="lbl">Target/Day</div>
      <div class="sub">if all logged</div>
    </div>
  </div>

  <!-- CALORIE METER + MACROS -->
  <div class="meter-section">
    <div style="display: flex; flex-direction: column; gap: 20px">
      <div>
        <div
          style="
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 12px;
          "
        >
          <div class="section-title" style="margin-bottom: 0">
            Calories Logged Today
          </div>
          <button class="ghost-btn" onclick="window.showCalRangeEditor()">
            Edit Range
          </button>
        </div>
        <div
          id="cal-range-editor"
          style="
            display: none;
            background: var(--surface2);
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 12px;
            margin-bottom: 12px;
          "
        >
          <div
            style="
              display: flex;
              gap: 10px;
              align-items: flex-end;
              flex-wrap: wrap;
            "
          >
            <div class="field-group" style="flex: 1; min-width: 80px">
              <span class="field-label" id="cal-range-low-label"
                >Floor (kcal)</span
              >
              <input
                id="cal-range-low-input"
                type="number"
                min="0"
                step="50"
              />
            </div>
            <div class="field-group" style="flex: 1; min-width: 80px">
              <span class="field-label" id="cal-range-high-label"
                >Ceiling (kcal)</span
              >
              <input
                id="cal-range-high-input"
                type="number"
                min="0"
                step="50"
              />
            </div>
            <div style="display: flex; gap: 6px">
              <button
                class="add-btn"
                style="padding: 6px 14px; font-size: 12px"
                onclick="window.saveCalRange()"
              >
                Save
              </button>
              <button
                class="ghost-btn"
                style="padding: 6px 12px; font-size: 12px"
                onclick="window.cancelCalRange()"
              >
                Cancel
              </button>
            </div>
          </div>
        </div>
        <div class="cal-meter">
          <div class="cal-fill" id="cal-fill" style="width: 0%"></div>
          <div class="target-zone">
            <span class="zone-label-low">1,250</span>
            <span class="zone-label-high">1,750</span>
          </div>
        </div>
        <div class="cal-scale" id="cal-scale"></div>
      </div>
      <div>
        <div class="section-title">Macro Split (logged)</div>
        <div class="macro-bar-wrap">
          <div class="macro-seg ms-p" id="bar-p" style="width: 34%"></div>
          <div class="macro-seg ms-c" id="bar-c" style="width: 33%"></div>
          <div class="macro-seg ms-f" id="bar-f" style="width: 33%"></div>
        </div>
        <div class="macro-legend">
          <div class="ml-item">
            <div class="ml-dot" style="background: var(--protein)"></div>
            Protein <span class="ml-val" id="leg-p">—</span>
          </div>
          <div class="ml-item">
            <div class="ml-dot" style="background: var(--carbs)"></div>
            Carbs <span class="ml-val" id="leg-c">—</span>
          </div>
          <div class="ml-item">
            <div class="ml-dot" style="background: var(--fat)"></div>
            Fat <span class="ml-val" id="leg-f">—</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- CORE FOOD ITEMS -->
  <div class="items-section">
    <div class="section-header">
      <div class="section-title" style="margin-bottom: 0">
        Saved Foods
      </div>
      <span
        style="
          font-family: &quot;DM Mono&quot;, monospace;
          font-size: 11px;
          color: var(--muted);
        "
        >+/− to log servings · toggle <span style="font-size: 9px">1/2 </span> button to enable half
        servings</span
      >
    </div>
    <div class="half-step-toggle-wrap">
      <button
        class="half-step-toggle"
        id="half-step-toggle-btn"
        onclick="window.toggleHalfStepMode()"
      >
        ½
      </button>
      <input
        type="text"
        id="core-items-filter"
        class="core-items-filter-input"
        placeholder="Search saved foods..."
        autocomplete="off"
      />
    </div>
    <div id="core-items-list"></div>
  </div>

  <!-- CUSTOM ITEMS -->
  <div class="items-section">
    <div class="section-header">
      <div class="section-title" style="margin-bottom: 0">
        Today's Custom Foods
      </div>
      <span
        style="
          font-family: &quot;DM Mono&quot;, monospace;
          font-size: 11px;
          color: var(--muted);
        "
        >resets daily · included in weekly cost</span
      >
    </div>
    <div id="custom-items-list"></div>

    <div class="add-section" id="custom-food-accordion">
      <div
        class="cf-accordion-header"
        onclick="this.closest('.add-section').classList.toggle('open')"
      >
        <div class="section-title" style="margin-bottom: 0">
          + Add Custom Food
        </div>
        <span class="cf-accordion-chevron">▼</span>
      </div>
      <div class="cf-accordion-body">
        <!-- Row 1: name + macros -->
        <div class="add-row add-row-1">
          <div class="field-group">
            <span class="field-label">Name</span>
            <input type="text" id="cf-name" placeholder="e.g. Banana" />
          </div>
          <div class="field-group">
            <span class="field-label" id="cf-cal-label"
              >Calories (kcal)</span
            >
            <input type="number" id="cf-cal" placeholder="105" min="0" />
          </div>
          <div class="field-group">
            <span class="field-label">Protein (g)</span>
            <input type="number" id="cf-p" placeholder="1" min="0" />
          </div>
          <div class="field-group">
            <span class="field-label">Carbs (g)</span>
            <input type="number" id="cf-c" placeholder="27" min="0" />
          </div>
          <div class="field-group">
            <span class="field-label">Fat (g)</span>
            <input type="number" id="cf-f" placeholder="0" min="0" />
          </div>
        </div>
        <!-- Row 2: cost fields -->
        <div class="add-row add-row-2">
          <div class="field-group">
            <span class="field-label" id="cf-bulk-price-label"
              >Bulk Total Price ($)</span
            >
            <input
              type="number"
              id="cf-bulk-price"
              placeholder="15.00"
              min="0"
              step="0.01"
              oninput="calcCostPerServing()"
            />
            <span class="field-hint">total you paid</span>
          </div>
          <div class="field-group">
            <span class="field-label">Servings in Package</span>
            <input
              type="number"
              id="cf-bulk-servings"
              placeholder="30"
              min="1"
              oninput="calcCostPerServing()"
            />
            <span class="field-hint">total servings</span>
          </div>
          <div class="field-group">
            <span class="field-label" id="cf-cost-label"
              >Cost / Serving ($)</span
            >
            <input
              type="number"
              id="cf-cost-per-srv"
              placeholder="0.50"
              min="0"
              step="0.01"
              oninput="clearBulkIfManual()"
            />
            <span class="field-hint" id="cf-cost-hint"
              >or enter manually</span
            >
          </div>
          <div class="field-group">
            <span class="field-label">Servings Eaten Today</span>
            <input
              type="number"
              id="cf-servings-eaten"
              placeholder="1"
              min="1"
              value="1"
              oninput="calcCostPerServing()"
            />
            <span class="field-hint" id="cf-today-cost-hint"
              >today's cost: $0.00</span
            >
          </div>
        </div>
        <!-- Row 3: add button -->
        <div class="add-row add-row-3">
          <div></div>
          <div></div>
          <button class="add-btn" onclick="window.addCustomItem()">
            + Add to Today
          </button>
          <button
            class="ghost-btn scan-cf-btn"
            onclick="window.startBarcodeFlowForCustomFood()"
          >
            Scan Barcode
          </button>
        </div>
      </div>
      <!-- end cf-accordion-body -->
    </div>
  </div>

  <!-- WEEKLY COST -->
  <div class="weekly-section">
    <div class="section-header" style="margin-bottom: 14px">
      <div class="section-title" style="margin-bottom: 0">
        Weekly Cost
      </div>
      <span
        style="
          font-family: &quot;DM Mono&quot;, monospace;
          font-size: 11px;
          color: var(--muted);
        "
        >week started <span id="week-start-label">—</span></span
      >
    </div>
    <div class="weekly-cols">
      <!-- TARGET/EXPECTED -->
      <div>
        <div class="weekly-col-title">
          Expected <span class="badge badge-target"
            >per week at target servings</span
          >
        </div>
        <div id="weekly-target-rows"></div>
        <div class="cost-total-row">
          <span>Weekly Target</span>
          <span class="amt target-amt" id="weekly-target-total"
            >$0.00</span
          >
        </div>
      </div>
      <!-- ACTUAL SPENT -->
      <div>
        <div class="weekly-col-title">Actual Spent</div>
        <div id="weekly-actual-rows"></div>
        <div class="cost-total-row">
          <span>Total Spent</span>
          <span class="amt actual-amt" id="weekly-actual-total"
            >$0.00</span
          >
        </div>
      </div>
    </div>
    <div class="cost-note">
      Actual cost reflects servings logged each day · <button
        onclick="window.resetWeeklyCost()"
        style="
          background: none;
          border: none;
          color: var(--muted);
          font-family: &quot;DM Mono&quot;, monospace;
          font-size: 11px;
          cursor: pointer;
          text-decoration: underline;
        "
      >
        reset week
      </button>
    </div>
  </div>

  <div class="reset-row">
    <button class="ghost-btn" onclick="window.confirmResetDay()">
      ↺ Reset Today's Log
    </button>
  </div>
  <div class="settings-section">
    <h2 class="settings-section-title">Free Calorie & Macro Tracker</h2>
    <div class="settings-section-body">
      <p class="settings-desc">
        Nawtch is a free nutrition, calorie and macros tracker that helps
        you monitor calories, macros, weight, spending and workouts
        without creating an account. Track meals with a food database and
        barcode scanner, monitor progress over time, and use our
        calculators, guides, tools, supplements and diet resources to support your
        goals. No sign-ups, no data tracking, free forever. Everything is
        stored locally in your browser, so your data is private and
        secure.
      </p>
    </div>
  </div>

  <!-- Barcode scanner -->
  <script
    src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"
    defer
  ></script>
  <script src="../islands/vanilla/today/today.js"></script>
</BaseLayout>
