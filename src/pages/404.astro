---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found — Nawtch"
  description="The page you're looking for doesn't exist. Head back to Nawtch's calorie tracker, calculators, or diet guides."
  canonicalPath="/404.html"
  noIndex={true}
  showLegalFooter={false}
  showSettingsHint={false}
>
  <div class="settings-section">
    <div class="error-404-wrap">
      <img class="error-404-img" src="/media/404.png" alt="Lost mascot illustration for a page that couldn't be found" width="1183" height="1330" />
      <h1 class="error-404-title">404 — Page Not Found</h1>
      <p class="error-404-subtitle">
        The page you're looking for doesn't exist or may have moved. Try one of these instead:
      </p>
      <div class="error-404-actions">
        <a class="add-btn" href="/">← Back to Today</a>
        <a class="ghost-btn" href="/calculators/">Calculators</a>
        <a class="ghost-btn" href="/diets/">Diets</a>
      </div>
    </div>
  </div>

  <Fragment slot="footer">
    <footer class="app-footer">
      <a class="footer-settings-btn" href="/settings/" data-page="settings" title="Settings"><span class="material-symbols-outlined">settings</span></a>
      <a class="footer-settings-btn" href="/guides/" data-page="guides" title="Guides"><span class="material-symbols-outlined">menu_book</span></a>
      <a class="footer-settings-btn" href="/calculators/" data-page="calculators" title="Calculators"><span class="material-symbols-outlined">calculate</span></a>
      <a class="footer-settings-btn" href="/diets/" data-page="diets" title="Diets"><span class="material-symbols-outlined">nutrition</span></a>
    </footer>
  </Fragment>
</BaseLayout>
