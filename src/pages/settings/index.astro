---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Settings & Data Backup — Nawtch"
  description="Manage your Nawtch calorie targets and weight units, and back up or restore all your data as a single JSON file."
  canonicalPath="/settings/"
>
  <header>
    <div class="header-left">
      <h1>Settings</h1>
      <p class="subtitle">Preferences · Backup &amp; restore</p>
    </div>
    <a class="ghost-btn" href="#" onclick="window.history.back(); return false;">← Back</a>
  </header>

  <!-- Where Your Data Lives -->
  <div class="settings-section">
    <h2 class="settings-section-title">Where Your Data Is Stored</h2>
    <div class="settings-section-body">
      <p class="settings-desc">
        Nawtch keeps everything — foods, logs, weight, programs, exercises, settings — locally in this browser, not on a server. Nothing leaves your device, but that also means <strong style="color:var(--warn);font-size:12px">clearing your browser's site data/cookies for this page, using private
        browsing, or uninstalling the browser can permanently erase your data.</strong> Export a backup below every so often to stay safe.
      </p>
    </div>
  </div>

  <!-- Calorie Range -->
  <div class="settings-section">
    <h2 class="settings-section-title">Calorie Target Range</h2>
    <div class="settings-section-body">
      <p class="settings-desc">
        Get a recommended target calorie estimate by using the <a href="/calculators/tdee/">TDEE calculator</a>.
      </p>
      <div style="display:flex;gap:10px;align-items:flex-end;flex-wrap:wrap;">
        <div class="field-group" style="flex:1;min-width:80px;">
          <span class="field-label" id="settings-cal-low-label">Floor (kcal)</span>
          <input id="settings-cal-low" type="number" min="0" step="50" />
        </div>
        <div class="field-group" style="flex:1;min-width:80px;">
          <span class="field-label" id="settings-cal-high-label">Ceiling (kcal)</span>
          <input id="settings-cal-high" type="number" min="0" step="50" />
        </div>
        <button class="add-btn" style="padding:6px 14px;font-size:12px;" onclick="window.saveCalRangeFromSettings()">Save</button>
      </div>
    </div>
  </div>

  <!-- Theme -->
  <div class="settings-section">
    <h2 class="settings-section-title">Theme</h2>
    <div class="settings-section-body">
      <p class="settings-desc">Choose light or dark, or follow your device's setting automatically.</p>
      <div class="wt-toggle" id="settings-theme-toggle"></div>
    </div>
  </div>

  <!-- Weight Unit -->
  <div class="settings-section">
    <h2 class="settings-section-title">Weight Unit</h2>
    <div class="settings-section-body">
      <p class="settings-desc">Choose the unit used for weight tracking. Applies everywhere weight is shown.</p>
      <div class="wt-toggle" id="settings-wt-unit-toggle"></div>
    </div>
  </div>

  <!-- Energy Unit -->
  <div class="settings-section">
    <h2 class="settings-section-title">Energy Unit</h2>
    <div class="settings-section-body">
      <p class="settings-desc">Choose the unit used for calories. Applies everywhere energy is shown.</p>
      <div class="wt-toggle" id="settings-energy-unit-toggle"></div>
    </div>
  </div>

  <!-- Currency -->
  <div class="settings-section" style="overflow:visible !important;">
    <h2 class="settings-section-title">Currency</h2>
    <div class="settings-section-body">
      <p class="settings-desc">Choose the currency symbol shown next to cost. This only changes the label — amounts are not converted.</p>
      <div class="export-dropdown" style="display: inline-block;" id="settings-currency-dropdown">
        <button class="ghost-btn export-dropdown-trigger" id="settings-currency-trigger" onclick="window.toggleCurrencyDropdown(event)">USD ($) ▾</button>
        <div class="export-dropdown-menu" id="settings-currency-menu"></div>
      </div>
    </div>
  </div>

  <!-- Backup -->
  <div class="settings-section">
    <h2 class="settings-section-title">Data Backup</h2>
    <div class="settings-section-body">
      <p class="settings-desc">Export all your data — foods, weight, programs, exercises, history, and settings — as a single JSON file. Use this to transfer everything to a new device.</p>
      <button class="ghost-btn" onclick="window.exportFullBackup()">↓ Export Full Backup (JSON)</button>
    </div>
  </div>

  <!-- Restore -->
  <div class="settings-section">
    <h2 class="settings-section-title">Data Restore</h2>
    <div class="settings-section-body">
      <p class="settings-desc">Import a Nawtch backup file to restore your data. <strong style="color:var(--warn);font-size:12px;">This will overwrite all existing data and cannot be undone.</strong></p>
      <input type="file" id="settings-import-file" accept=".json" style="display:none" onchange="window.handleImportFile(event)" />
      <button class="ghost-btn" onclick="document.getElementById('settings-import-file').click()">↑ Import Backup (JSON)</button>
    </div>
  </div>

  <script src="../../islands/vanilla/settings/settings.js"></script>
</BaseLayout>
