  canonicalPath="/calculators/one-rep-max/"
  bodyClass="calculators"
>
  <header>
    <div class="header-left">
      <h1>One Rep Max Calculator</h1>
      <p class="subtitle">Estimate your max one-rep lift, the max weight you can lift for a single repetition for a given exercise.</p>
    </div>
